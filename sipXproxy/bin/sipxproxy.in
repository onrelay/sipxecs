#!@BASH@
# sipxproxy - Startup script for sipxproxy

# description: sipxproxy is a SIP proxy for telecommunications
# processname: sipXproxy

# Copyright (C) 2007 Pingtel Corp., certain elements licensed under a Contributor Agreement.  
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the LGPL license.

. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

prog=sipXproxy
exec="@SIPX_BINDIR@/${prog}"
config="@SIPX_CONFDIR@/sipXproxy-config"
pidfile="@SIPX_RUNDIR@/sipxproxy/sipxproxy.pid"
regex="^$exec"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog

start() {
  [ -x $exec ] || { echo -n "$execError"; echo_failure; exit $ENOEXEC; }
  [ -f $config ] || { echo -n "$invalidFileError"; echo_failure; exit $ENOENT; }
 if [ -n "${NoFork}" ] ; then
    killAnyProcessOrphans "${pidfile}" "${regex}"
    runuser -s /bin/bash @SIPXPBXUSER@ -c $exec
  else
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && { echo_running; exit $ERUNNING; }
      
    echo -n $"Starting $prog: "
    runuser -s /bin/bash @SIPXPBXUSER@ -c "$exec --pid-file $pidfile > /dev/null 2>&1 & echo \$!" > ${pidfile}
    Status=$?

    if [ $# -gt 0 ]; then
      #check if process spawned
      checkRunningProcessTimeout "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
      checkIfProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] && { echo_success; }
  [ $Status -eq 0 ] || { echo_failure; }
}

restart() {
  stop
  start $withCheck
}

asyncrestart() {
  stop
  start
}

configtest() {
  myDomain=`sipx_config_value @SIPX_CONFDIR@/domain-config SIP_DOMAIN_NAME`
  Status=$((${Status} + $?))
  sipx_config_exists @SIPX_CONFDIR@/sipXproxy-config
  proxy_config_status=$?
  Status=$((${Status} + ${proxy_config_status}))

  # check validity of xml routing rules, and authorization rules
  @bindir@/sipx-validate-xml @SIPX_CONFDIR@/forwardingrules.xml
  Status=$((${Status} + $?))
  @bindir@/sipx-validate-xml @SIPX_CONFDIR@/authrules.xml
  Status=$((${Status} + $?))
  @bindir@/sipx-validate-xml @SIPX_CONFDIR@/nattraversalrules.xml
  Status=$((${Status} + $?))

  # Check that the log file is writable.
  logfile="@SIPX_LOGDIR@/sipXproxy.log"
  if [ -e $logfile -a ! -w $logfile ]
  then
    echo "Log file '$logfile' exists but is not writable by user '@SIPXPBXUSER@'." >&2
    Status=1
  fi

  if [ ${proxy_config_status} -eq 0 ]
  then
    myIp=`sipx_config_value @SIPX_CONFDIR@/sipXproxy-config SIPX_PROXY_BIND_IP 2> /dev/null`
    if ! sip_resolves_to ${myDomain} ${myIp}
    then
      cat <<ERROR
  SIP route to SIPXCHANGE_DOMAIN_NAME '${myDomain}' is not to my IP address: ${myIp}
  See the installation guide on setting the DNS SRV records and domain names
ERROR
         Status=1
    fi
  fi
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start $withCheck
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  asyncrestart)
    asyncrestart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${regex}"
    Status=$?
    ;;
  configtest)
    configtest
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|asyncrestart|reload|force-reload|condrestart|nofork}"
    Status=$EINCORRECTUSAGE
esac

exit $Status
