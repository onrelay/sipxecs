function build() 
{
    echo "Begin build()"

    cd ${BUILD_DIR}

 
    # The make command may kick a permission error when creating RPMs

    if [ -z "${RPM}" ]; then

        sudo make ${SUBPROJECT}
    
    else

        echo "RPMs will be generated locally at ${LOCAL_REPO}"

        sudo make ${SUBPROJECT}.rpm       
    fi

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "make error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "Done build()"
}

function install() 
{
    echo "Begin install()"

    cd ${BUILD_DIR}

    # 'repomanage' lists the most recent RPMs in a directory
    sudo yum localinstall ${INSTALL_OPTIONS} $(repomanage ${LOCAL_REPO})

    echo "Done install()"
}

function main()
{

    echo "Starting ${THIS_MASTER_BUILD_SCRIPT}"

    checkUser

    checkInput $@

    checkSELinux

    init

    addRepos

    case $PLATFORM in

        "centos-7")
            setupCentOS7
            configureCentOS7
            ;;

        "centos-9")
            setupCentOS9
            configureCentOS9
            ;;

        "rocky-9")
            setupRocky9
            configureRocky9
            ;;

        *)
            echo "Error: Unknown platform ${PLATFORM}"
            exit 1
            ;;
    esac
    
    build

    if [ ! -z "${INSTALL}" ]; then

        install

    fi

    echo "Finished ${THIS_MASTER_BUILD_SCRIPT}"
}

main $@