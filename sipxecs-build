function setupRocky9() 
{
    echo "Begin setupRocky9()"

    echo "installing build tools"
    sudo dnf install ${INSTALL_OPTIONS} make autoconf automake libtool epel-release cmake gem httpd hostname

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing standard base OS repo tools"
    sudo dnf install ${INSTALL_OPTIONS} libtool gcc-c++ openssl-devel boost-devel poco-devel java-17-openjdk-devel 

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing standard devel repo tools"
    dnf config-manager --enable devel
    #sudo dnf install ${INSTALL_OPTIONS}  v8-devel policycoreutils-python-utils gcc-plugin-devel

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing epel repo tools"
    dnf config-manager --enable epel
    #sudo dnf install ${INSTALL_OPTIONS} gperftools-devel poco-devel gtest-devel hiredis-devel leveldb-devel libdnet-devel libmcrypt-devel mongo-c-driver-devel utf8proc-devel

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing crb repo tools"
    dnf config-manager --enable crb
    # sudo dnf install ${INSTALL_OPTIONS} cppunit-devel poco-devel zeromq-devel cppzmq-devel libconfig-devel libpcap-devel libsrtp-devel libdb-cxx-devel

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing rpms from sipXecs repo"
    dnf config-manager --enable sipxcom
    sudo dnf install ${INSTALL_OPTIONS} freeswitch-devel

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    if [ "${SUBPROJECT}" != "mongo-cxx-driver" ] && [ "${SUBPROJECT}" != "lib" ]; then
        echo "installing mongo-cxx-driver from sipxcom repo"
        sudo dnf install ${INSTALL_OPTIONS} mongo-cxx-driver-devel 

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
    fi

    if [ "${SUBPROJECT}" != "jetty" ] && [ "${SUBPROJECT}" != "lib" ]; then
        echo "installing jetty from sipxcom repo"
        sudo dnf install ${INSTALL_OPTIONS} jetty 

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
    fi

    if [ "${SUBPROJECT}" != "cfengine" ] && [ "${SUBPROJECT}" != "lib" ]; then
        echo "installing cfengine from sipxcom repo"
        sudo dnf install ${INSTALL_OPTIONS} cfengine-community

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
    fi

    if [ "${SUBPROJECT}" != "dart-sdk" ] && [ "${SUBPROJECT}" != "lib" ]; then
        echo "installing dart-sdk from sipxcom repo"
        sudo dnf install ${INSTALL_OPTIONS} dart-sdk

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
    fi

    echo "installing elasticsearch from elasticsearch repo"
    dnf config-manager --enable elasticsearch
    sudo dnf install ${INSTALL_OPTIONS} elasticsearch

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "installing MongoDB from mongodb-org-8.0 repo"
    dnf config-manager --enable mongodb-org-8.0
    sudo dnf install ${INSTALL_OPTIONS} mongodb-org

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "dnf install error, exiting sipxecs-build"
        exit ${ERROR}
    fi 
    

    if [ "${RPM}" != "" ]; then

        echo "Setting rpmbuild to ${BUILD_DIR}/rpmbuild"
	    echo "%_topdir      ${BUILD_DIR}/rpmbuild" >> ~/.rpmmacros

        echo "installing standard RPM tools"
        sudo dnf install ${INSTALL_OPTIONS} createrepo rpm-build podman

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 

        echo "installing crb RPM tools"
        dnf config-manager --enable crb
        sudo dnf install ${INSTALL_OPTIONS} mock

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
        sudo usermod -a -G mock sipx

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 

        echo "installing  other sipxcom RPM tools"
        sudo dnf install ${INSTALL_OPTIONS} thttpd 

        ERROR=$?
        if [ ${ERROR} -ne 0 ]; then 
            echo "dnf install error, exiting sipxecs-build"
            exit ${ERROR}
        fi 
    fi

    # cd ${BUILD_DIR}
    # sudo echo oss_core > .modules-exclude

    echo "Done setupRocky9()"
}


function configureCentOS7() 
{
    echo "Begin configureCentOS7()"

    sed -i "/^AC_INIT.*/ s//AC_INIT(sipX, ${VERSION}, ${SIPXCOM_USER_GROUP})/" ${SOURCE_DIR}/configure.ac

    cd ${SOURCE_DIR}
    sudo autoreconf -ivf

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "autoreconf error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    cd ${BUILD_DIR}

    sudo echo '$(sipx_all)' > .modules-include

    if [ -z "${RPM}" ]; then
        sudo ../configure
    else
        sudo ../configure --enable-rpm DISTRO="${PLATFORM}-${ARCHITECTURE}"
    fi

    ERROR=$?
    if [ ${ERROR} -ne 0 ]; then 
        echo "configure error, exiting sipxecs-build"
        exit ${ERROR}
    fi 

    echo "Done configureCentOS7()"
}

