#!/bin/bash
# sipxpage - Startup script for sipxpage

# description: sipxpage is a SIP proxy for telecommunications
# processname: sipxpage

# Copyright (C) 2007 Pingtel Corp., certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the LGPL license.

. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

prog=sipxpage
pidfile="@SIPX_RUNDIR@/$prog/$prog.pid"
regex="^@SIPX_RUNDIR@/$prog/java-$prog"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog

start() {
  JavaCmd=`@SIPX_BINDIR@/sipx-config --java --pidfile "${pidfile}"`
  Dependencies=`@SIPX_BINDIR@/java-dep -d @SIPX_JAVADIR@/sipXcommons @page_PKGS@`
  export CLASSPATH=`echo @SIPX_JAVADIR@/sipXpage/*.jar ${Dependencies} | sed -e 's/ /:/g'`

  # -Dprocname is there so cfengine can find it
  Command="$JavaCmd \
    -Dconf.dir=@SIPX_CONFDIR@ \
    -Dlog.dir=@SIPX_LOGDIR@ \
    ${SIPXPAGE_OPTS} \
    org.sipfoundry.sipxpage.SipXpage \
    $Args"
  if [ -n "${NoFork}" ] ; then
    killAnyProcessOrphans "${pidfile}" "${regex}"
    runuser -s /bin/bash @SIPXPBXUSER@ -c ${Command}
  else
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && { echo_running; exit $ERUNNING; }

    echo -n $"Starting $prog: "
    runuser -s /bin/bash @SIPXPBXUSER@ -c "${Command} > /dev/null 2>&1 & echo \$!" > ${pidfile}
    Status=$?

    if [ $# -gt 0 ]; then
      #check if process was spawned
      checkRunningProcessTimeout "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH;}
      checkIfProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}

restart() {
  stop
  start $withCheck
}

asyncrestart() {
  stop
  start
}

configtest() {
  sipx_config_exists @SIPX_CONFDIR@/sipxpage.properties
  Status=$(($Status+$?))

  # check validity of xml files
  @bindir@/sipx-validate-xml @SIPX_CONFDIR@/autoattendants.xml
  Status=$(($Status+$?))

  # Check that the log file is writable.
  logfile="@SIPX_LOGDIR@/sipxpage.log"
  if [ -e $logfile -a ! -w $logfile ]
  then
      echo "Log file '$logfile' exists but is not writable." >&2
      Status=$ENOTWRITABLE
  fi
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start $withCheck
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  asyncrestart)
    asyncrestart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${regex}"
    Status=$?
    ;;
  configtest)
    configtest
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|asyncrestart|reload|force-reload|condrestart|nofork}"
    Status=$EINCORRECTUSAGE
esac

exit $Status
