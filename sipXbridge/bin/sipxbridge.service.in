[Unit]
Description=sipxbridge
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service sipxproxy.service 

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxbridge start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxbridge stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxbridge/sipxbridge.pid

[Install]
WantedBy=multi-user.target
