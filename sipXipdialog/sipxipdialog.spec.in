Name: @PACKAGE@
Version: @VERSION@
Release: @PACKAGE_REVISION@

Summary: VoIP PBX 
License: LGPL
Group: Telcommunications
Vendor: SIPfoundry
Packager: SIPfoundry <sipx-dev@sipfoundry.org>
Url: http://www.sipfoundry.org


# do not build a debuginfo package
%define debug_package %{nil}

BuildRequires: java-17-openjdk-devel
BuildRequires: automake
BuildRequires: sipxcommons >= %version
BuildRequires: sipxconfig >= %version

Requires: sipxconfig

Source: %name-%version.tar.gz

Prefix: %_prefix
BuildRoot: %{_tmppath}/%name-%version-root

%description
Configuration support ipdialog phones

%prep
%setup -q

%build
%configure
make

%install
rm -rf $RPM_BUILD_ROOT
make DESTDIR=$RPM_BUILD_ROOT install

%clean
rm -rf $RPM_BUILD_ROOT

%files
%defattr(644,root,root,755)
%{_sysconfdir}/sipxpbx/ipDialog/*
%{_datadir}/java/sipXecs/sipXconfig/plugins/sipXipdialog.jar



