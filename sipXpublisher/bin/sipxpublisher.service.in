[Unit]
Description=sipxpublisher
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxpublisher start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxpublisher stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxpublisher/sipxpublisher.pid

[Install]
WantedBy=multi-user.target
