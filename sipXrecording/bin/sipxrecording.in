#!/bin/bash
# sipXrecording - Startup script for sipxrecording

# description: sipxrecording is an recording service that works with freeswitch
# processname: sipxrecording

# Copyright (C) 2012 eZuce Inc., certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the AGPL license.

. @SIPX_LIBEXECDIR@/sipx-utils.sh || exit 1

prog=sipxrecording
config_props="@SIPX_CONFDIR@/$prog.properties"
pidfile="@SIPX_RUNDIR@/$prog/$prog.pid"
regex="^@SIPX_RUNDIR@/$prog/java-$prog"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog


configtest() {  
  Status=$((${Status} + $?))

  # Check that the log file is writable.
  logfile="@SIPX_LOGDIR@/sipXrecording.log"
  if [ -e $logfile -a ! -w $logfile ]
  then
    echo "Log file '$logfile' exists but is not writable by user '@SIPXPBXUSER@'." >&2
    Status=1
  fi
}

# Start sipxrecording
start() {
  [ -f $config_props ] || exit 6
  
  JavaCmd=`@SIPX_BINDIR@/sipx-config --java --pidfile "${pidfile}"`
  Dependencies=`@SIPX_BINDIR@/java-dep -d @SIPX_JAVADIR@/sipXcommons @recording_PKGS@`
  export CLASSPATH=`echo @SIPX_CONFDIR@/sipxrecording @SIPX_JAVADIR@/{sipXrecording,sipXopenfire/plugins}/*.jar ${Dependencies} | sed -e 's/ /:/g'`  
  
  Command="$JavaCmd \
    -Dconf.dir=@SIPX_CONFDIR@ \
    -Dvar.dir=@SIPX_VARDIR@ \
    -Dhazelcast.config=@SIPX_CONFDIR@/hz-config.xml \
    org.sipfoundry.sipxrecording.SipXrecording \
    $Args"
  if [ -n "${NoFork}" ] ; then
    runuser -s /bin/bash @SIPXPBXUSER@ -c ${Command}
  else
    checkRunningProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && { echo_running; exit $ERUNNING; }

    echo -n $"Starting $prog: "
    runuser -s /bin/bash @SIPXPBXUSER@ -c "${Command} > /dev/null 2>&1 & echo \$!" > ${pidfile}
    Status=$?

    if [ $# -gt 0 ]; then
      #check if process was spawned
      checkRunningProcessTimeout "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
      checkIfProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi  
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}

restart() {
    stop
    # sleep for no good reason. Can be disconcerting if stop/start
    # switch is too fast IMHO
    sleep 1
    start
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${regex}"
    ;;
  configtest)
    configtest
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|reload|force-reload|condrestart|nofork}"
    Status=1
esac

exit $Status