[Unit]
Description=sipxrecording
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxrecording start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxrecording stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxrecording/sipxrecording.pid

[Install]
WantedBy=multi-user.target
