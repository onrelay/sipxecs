<?xml version="1.0"?>
<!DOCTYPE model PUBLIC "-//sipXconfig//Model specification 2.0//EN" 
  "/etc/sipxpbx/setting.dtd" [
  <!ENTITY types SYSTEM "types.xml">
  ]>
<model>
  <group name='network'>
    <label>Network</label>
    <setting name="dhcpenable">
      <type>
        <boolean></boolean>
      </type>
      <value>1</value>
    </setting>
    <setting name="tftp_config">
      <type>
        <boolean></boolean>
      </type>
      <value>1</value>
    </setting>
    <setting name="pppoe_enable">
      <type>
        <boolean></boolean>
      </type>
      <value>0</value>
    </setting>
  </group>
  <group name="e911" hidden="yes">
    <setting name="location">
      <type>
        <integer/>
      </type>
    </setting>    
  </group>
</model>