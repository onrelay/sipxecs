[Unit]
Description=sipxivr
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxivr start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxivr stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxivr/sipxivr.pid

[Install]
WantedBy=multi-user.target
