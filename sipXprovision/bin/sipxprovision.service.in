[Unit]
Description=sipxprovision
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxprovision start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxprovision stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxprovision/sipxprovision.pid

[Install]
WantedBy=multi-user.target
