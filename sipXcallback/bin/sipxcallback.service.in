[Unit]
Description=sipxcallback
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target sipxproxy.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxcallback start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxcallback stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxcallback/sipxcallback.pid

[Install]
WantedBy=multi-user.target
