#!/bin/bash

# sipxcallback - Startup script for sipxcallback

# chkconfig: 35 97 15
# description: sipxcallback is Call Back on Busy using FreeSwitch
# processname: sipxcallback

#
# Copyright (C) 2015 sipXcom., certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the LGPL license.

. @SIPX_LIBEXECDIR@/sipx-utils.sh || exit 1

prog=sipxcallback
pidfile="@SIPX_RUNDIR@/$prog/$prog.pid"
regex="^@SIPX_BINDIR@/$prog/java-$prog"


[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog


start() {
    echo -n $"Starting $prog: "

    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && { echo_running; exit $ERUNNING; }
    
    JavaCmd=`@SIPX_BINDIR@/sipx-config --java --prog "${prog}"`
    Dependencies=`@SIPX_BINDIR@/java-dep -d @SIPX_JAVADIR@/sipXcommons @sipxcall_PKGS@`
    export CLASSPATH=`echo @SIPX_CONFDIR@/sipxcallback @SIPX_JAVADIR@/sipXcallback/*.jar ${Dependencies} | sed -e 's/ /:/g'`

    setJavaSslOpts
    setJavaServiceOpts

    # procname is there so cfengine can find it
    Command="$JavaCmd \
      -Dconf.dir=@SIPX_CONFDIR@ \
      -Dlog.dir=@SIPX_LOGDIR@ \
      -Dvar.dir=@SIPX_VARDIR@ \
      -Dstdprompts.dir=@wwwdir@/doc/stdprompts \
      $JavaSslOpts \
      $JavaServiceOpts \
      ${SIPXCALL_OPTS} \
         org.sipfoundry.sipxcallback.SipXcallbackServer \
	 $Args"
    if [ -n "${NoFork}" ] ; then
      runuser -s /bin/bash @SIPXPBXUSER@ -c ${Command}
    else
      runuser -s /bin/bash @SIPXPBXUSER@ -c "${Command} > /dev/null 2>&1 & echo \$!" > ${pidfile}
      Status=$?

      if [ $# -gt 0 ]; then
        #check if process was spawned
        checkRunningProcessTimeout "${pidfile}" "${regex}" > /dev/null 2>&1
        Status=$?
        [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
        checkProcessIsListeningTimeout "${pidfile}" "${regex}" > /dev/null 2>&1
        Status=$?
        [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
        [ $Status -eq 0 ] && { echo_success; }
      else
        [ $Status -eq 0 ] || { echo_failure; }
        [ $Status -eq 0 ] && { echo_success; }  
      fi
    fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}

restart() {
  stop
  start
}

configtest() {
     sipx_config_exists @SIPX_CONFDIR@/sipxcallback.properties
     Status=$(($Status+$?))

     # Check that the log file is writable.
     logfile="@SIPX_LOGDIR@/sipxcallback.log"
     if [ -e $logfile -a ! -w $logfile ]
     then
         echo "Log file '$logfile' exists but is not writable." >&2
         Status=1
     fi
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${regex}" 
    ;;
  configtest)
    configtest
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|reload|force-reload|condrestart|nofork|configtest}"
    Status=1
esac

exit $Status
