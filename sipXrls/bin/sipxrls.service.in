[Unit]
Description=sipxrls
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target postgresql.service mongod.service
Requires=postgresql.service mongod.service


[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxrls start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxrls stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxrls/sipxrls.pid

[Install]
WantedBy=multi-user.target
