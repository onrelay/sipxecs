[Unit]
Description=sipxsaa
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxsaa start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxsaa stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxsaa/sipxsaa.pid

[Install]
WantedBy=multi-user.target
