#!@BASH@
# sipxsaa - Startup script for sipxsaa

# description: sipxsaa is a SIP presence for telecommunications
# processname: sipXsaa

# Copyright (C) 2009 Nortel, certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the LGPL license.

. /etc/rc.d/init.d/functions || exit $ENOENT
. @SIPX_LIBEXECDIR@/sipx-utils.sh || exit $ENOENT

prog=sipxsaa
exec="@SIPX_BINDIR@/${prog}"
config="@SIPX_CONFDIR@/sipxsaa-config"
pidfile="@SIPX_RUNDIR@/sipxsaa/sipxsaa.pid"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog

start() {
  [ -x $exec ] || { echo -n "$execError"; echo_failure; exit $ENOEXEC; }
  [ -f $config ] || { echo -n "$invalidFileError"; echo_failure; exit $ENOENT; }
  if [ -n "${NoFork}" ] ; then
    killAnyProcessOrphans "${pidfile}" "${exec}"
    runuser -s /bin/bash @SIPXPBXUSER@ -c $exec
  else
    checkRunningProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && { echo -n "$prog $runningError"; echo_failure; exit $ERUNNING; }

    echo -n $"Starting $prog: "
    runuser -s /bin/bash @SIPXPBXUSER@ -c "$exec --pid-file $pidfile > /dev/null 2>&1 & echo \$!" > ${pidfile}
    Status=$?

    if [ $# -gt 0 ]; then
      #check if process was spawned
      checkRunningProcessTimeout "${pidfile}" "${exec}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
      checkIfProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${exec}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}


restart() {
  stop
  start $withCheck
}

asyncrestart() {
  stop
  start
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start $withCheck
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  asyncrestart)
    asyncrestart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${exec}"
    Status=$?
    ;;
  configtest)
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|asyncrestart|reload|force-reload|condrestart|nofork}"
    Status=$EINCORRECTUSAGE
esac

exit $Status
