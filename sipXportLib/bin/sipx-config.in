#!/bin/sh

# Purpose of this script is to return locations of programs and
# settings used by the sipx family of modules.  This is installed for
# runtime scripts' usage.
# Configuration information about the sipX modules themselves is
# printed by the sipx*-config scripts.

# DEVELOPER NOTE: This is not meant to replace autoconf
# macros. Instead this is to find programs (like java) that can differ
# from what is used to compile then what is used to run.  This
# difference is extremely important when building binary distributions
# like RPMs

MyDir=`dirname $0`
PATH=$PATH:$MyDir

Action="HELP"
ToolCommand=""
ToolName=""
JavaVersions="17\."
PythonVersions="3\."
NodeVersions="v(16|18|20)\."
CommonArgs=""
Prog=""

# Generic test function for any binary
testTool()
{
    CommandCandidate=$1
    if [ ! -x "$CommandCandidate" ]; then return 1; fi
    
    # Version checks based on the BASE name of the tool
    BaseName=$(basename "$ToolName")
    case "$BaseName" in
        java)
            Ver=`"$CommandCandidate" -version 2>&1`
            if ! echo "$Ver" | grep "$JavaVersions" >/dev/null; then
                echo "Version $Ver not compatible" 1>&2
                return 1
            fi
            ;;
        python*|python3*)
            Ver=`"$CommandCandidate" --version 2>&1`
            if ! echo "$Ver" | grep "$PythonVersions" >/dev/null; then
                echo "Version $Ver not compatible" 1>&2
                return 1
            fi
            ;;
        node)
            Ver=`"$CommandCandidate" --version 2>&1`
            if ! echo "$Ver" | grep -E "$NodeVersions" >/dev/null; then
                echo "Version $Ver not compatible" 1>&2
                return 1
            fi
            ;;
    esac

    ToolCommand=$CommandCandidate
    return 0
}

# Find function handling paths vs names
findTool()
{
    # If ToolName is a path (contains /), test it directly
    case "$ToolName" in
        */*)
            testTool "$ToolName"
            ;;
        java)
            if [ -n "${SIPX_JAVA_HOME}" ]; then
                testTool "${SIPX_JAVA_HOME}/bin/java" || \
                testTool "${SIPX_JAVA_HOME}/jre/bin/java"
            else
                testTool `which java`
            fi
            ;;
        *)
            testTool `which "$ToolName"`
            ;;
    esac
}

# Creates symlink: /run/sipx/myapp.pid -> /run/sipx/node-myapp
createSymlink()
{
    
    # Use the base name of the tool for the prefix (e.g. 'node' or 'java')
    Prefix=$(basename "$ToolName")
    
    SymlinkPath="/usr/bin/${Prefix}-${Prog}"
    
    ln -sf "$ToolCommand" "$SymlinkPath"
    
    ToolCommand="$SymlinkPath"
}

## Main program loop
while [ "$#" -ne 0 ]
do
    case ${1} in
        --java)   Action=RUN; ToolName="java" ;;
        --perl)   Action=RUN; ToolName="perl" ;;
        --python) Action=RUN; ToolName="python3" ;;
        --ruby)   Action=RUN; ToolName="ruby" ;;
        --node)   Action=RUN; ToolName="node" ;;
        --tool)   # New flag for custom paths
            Action=RUN
            ToolName="${2}"
            shift
            ;;
        --prog)
            Prog="${2}"
            shift
            ;;
        *) Action=HELP ;;
    esac
    shift
done

if [ "$Action" = "RUN" ]; then
    findTool

    if [ -z "$ToolCommand" ]; then
        echo "Cannot locate $ToolName" >&2
        exit 1
    fi

    if [ -n "$Prog" ]; then
        createSymlink "$Prog"
    fi

    echo "$ToolCommand $CommonArgs"
    exit 0
fi

cat <<USAGE
Usage:
    ./sipx-config --java   [--prog program]
    ./sipx-config --perl   [--prog program]
    ./sipx-config --python [--prog program]
    ./sipx-config --ruby   [--prog program]
    ./sipx-config --node   [--prog program]
    ./sipx-config --tool /path/to/tool [--prog program]

Options:
    --tool <path>  Use a specific binary path instead of searching PATH
USAGE
exit 1
