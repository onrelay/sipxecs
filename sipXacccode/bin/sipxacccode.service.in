[Unit]
Description=sipxacccode
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target named.service sipxproxy.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxacccode start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxacccode stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxacccode/sipxacccode.pid

[Install]
WantedBy=multi-user.target
