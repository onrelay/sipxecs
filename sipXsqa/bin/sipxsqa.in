#!@BASH@
# sipxsqa - Startup script for sipxsqa

# description: sipxsqa is a SIP park for telecommunications
# processname: sipXsqa

# Copyright (C) 2007 Pingtel Corp., certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the LGPL license.

. /etc/rc.d/init.d/functions || exit $ENOENT
. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

prog=sipxsqa
exec="@SIPX_BINDIR@/${prog}"
config="@SIPX_CONFDIR@/sipxsqa-config"
mongoconfig="@SIPX_CONFDIR@/mongo-client.ini"
pidfile="@SIPX_RUNDIR@/sipxsqa/sipxsqa.pid"
logfile="@SIPX_LOGDIR@/sipxsqa.log"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog

start() {
  [ -x $exec ] || { echo -n "$execError"; echo_failure; exit $ENOEXEC; }
  [ -f $config ] || { echo -n "$invalidFileError"; echo_failure; exit $ENOENT; }
  if [ -n "${NoFork}" ] ; then
    killAnyProcessOrphans "${pidfile}" "${exec}"
    runuser -s /bin/bash @SIPXPBXUSER@ -c "$exec  \
      --config-file $config \
      --pid-file $pidfile \
      --log-file $logfile"
  else
    checkRunningProcessIsListening "${pidfile}" "${exec}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && { echo -n "$prog $runningError"; echo_failure; exit $ERUNNING; }

    echo -n $"Starting $prog: "

    runuser -s /bin/bash @SIPXPBXUSER@ -c "$exec \
        --config-file $config \
        --pid-file $pidfile \
        --log-file $logfile > /dev/null 2>&1 & echo \$!" > ${pidfile}

    Status=$?

    if [ $# -gt 0 ]; then
      #check if process was spawned
      checkRunningProcessTimeout "${pidfile}" "${exec}"
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
      checkIfProcessIsListening "${pidfile}" "${exec}"
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${exec}"
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}


restart() {
  stop
  start $withCheck
}

asyncrestart() {
  stop
  start
}

configtest() {
  if [ -e $logfile -a ! -w $logfile ]
  then
     echo "Log file '$logfile' exists but is not writable by user '@SIPXPBXUSER@'." >&2
     Status=1
  fi
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start $withCheck
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  asyncrestart)
    asyncrestart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${exec}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${exec}"
    Status=$?
    ;;
  configtest)
    configtest
    ;;
  *)
    echo "Usage: $0 {start|stop|status|restart|asyncrestart|reload|force-reload|condrestart|nofork}"
    Status=$EINCORRECTUSAGE
esac

exit $Status
