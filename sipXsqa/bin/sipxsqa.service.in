[Unit]
Description=sipxsqa
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxsqa start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxsqa stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxsqa/sipxsqa.pid

[Install]
WantedBy=multi-user.target
