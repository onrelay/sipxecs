#
# Configure ssh access to machines using same keys Cfengine uses for communication
# Generally modules configure what ssh commands as root are allowed to be run 
# on a machine by the unprivledged user 'sipx'.
#
# Utility methods are in sipx.cf such as
#   allow_ssh_command
#   disallow_ssh_command
#

bundle agent 00_ssh
{
  vars:
    "passphrase" string => "Cfengine passphrase";
    "home"       string => "$(sipx.SIPX_CONFDIR)";
    "sshdir"     string => "$(home)/.ssh";
    "ppkdir"     string => "$(home)/.cfagent/ppkeys";
    "pvkey"      string => "$(ppkdir)/localhost.priv";
    "nopasskey"  string => "$(ppkdir)/localhost.nopass.priv";
    "key_file"   string => "$(sipx.SIPX_CFDATA)/primary.ssh.pub";
    
    "root_ppkdir"  string => "/root/.cfagent/ppkeys";
    "root_nopass"  string => "$(root_ppkdir)/localhost.nopass.priv";
    "root_sshdir"  string => "/root/.ssh";

  classes:
    "pvkey_exists"   expression => fileexists("$(pvkey)");
    
    "missing_nopass" not => fileexists("$(nopasskey)");
    "empty_nopass"   expression => returnszero("/usr/bin/test ! -s $(nopasskey)", "noshell");
    "old_nopass"     expression => isnewerthan("$(pvkey)", "$(nopasskey)");
    
    "rebuild_nopass" expression => "missing_nopass|empty_nopass|old_nopass";

    "nopass_ready"   expression => fileexists("$(nopasskey)");
    
    "missing_pub"    not => fileexists("$(key_file)");
    "empty_pub"      expression => returnszero("/usr/bin/test ! -s $(key_file)", "noshell");
    "old_pub"        expression => isnewerthan("$(nopasskey)", "$(key_file)");
    
    "rebuild_pub"    expression => "missing_pub|empty_pub|old_pub";
    
    "keys_ready"     expression => returnszero("/usr/bin/test -s $(key_file)", "noshell");

  files:
    "$(home)/."   
      perms => mog("755", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"), 
      create => "true";

    # Enforce parent directory ownership immediately without recursion for cf-key safety
    "$(home)/.cfagent/."
      perms => mog("755", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"),
      create => "true";

    "$(sipx.SIPX_CFDATA)/."
      perms => mog("755", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"),
      create => "true";

    "$(sshdir)/." 
      perms => mog("700", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"), 
      create => "true";
      
    "$(ppkdir)/." 
      perms => mog("700", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"), 
      create => "true";

    keys_ready::
      "$(sshdir)/authorized_keys"
        create => "true",
        perms  => mog("644", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)"),
        edit_line => authorized_sipx_commands;

      "$(root_sshdir)/."
        create => "true",
        perms  => mog("700", "root", "root");

      "$(root_sshdir)/authorized_keys"
        create => "true",
        perms  => mog("600", "root", "root"),
        edit_line => authorized_root_commands,
        comment   => "Authorize the sipx public key for root login";

    nopass_ready::
      "$(nopasskey)"
        perms => mog("600", "$(sipx.SIPXPBXUSER)", "$(sipx.SIPXPBXGROUP)");

      "$(root_ppkdir)/."
        create => "true",
        perms  => mog("700", "root", "root");

      "$(root_nopass)"
        copy_from => local_cp("$(nopasskey)"),
        perms     => mog("600", "root", "root"),
        comment   => "Copy nopass key to root home";

  commands:
    primary.!pvkey_exists::
      "/bin/su"
        args => "- $(sipx.SIPXPBXUSER) -c '/usr/local/sbin/cf-key'",
        comment => "Generate initial keys as sipx user to fix timing issue";

    primary.pvkey_exists.rebuild_nopass::
      "/usr/bin/openssl"
        args => "rsa -in $(pvkey) -passin 'pass:$(passphrase)' -out $(nopasskey)",
        handle => "generate_nopass_key",
        contain => in_shell;

    primary.rebuild_pub::
      "/usr/bin/ssh-keygen"
        args => "-y -f $(nopasskey) > $(key_file)",
        depends_on => { "generate_nopass_key" },
        contain => in_shell;
}

bundle edit_line authorized_root_commands
{
  vars:
    any::
      "key" string => readfile("$(00_ssh.key_file)", "2000");

  delete_lines:
    "^.*\\ssipx@primary$";

  insert_lines:
    "from=\"$(sipx.master_address)\" $(key) sipx@primary";
}