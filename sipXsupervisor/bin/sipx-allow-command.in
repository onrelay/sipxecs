#!/bin/sh
conf=@SIPX_CONFDIR@/.ssh/authorized_sipx_commands
if ! test -f "$conf"; then
   echo "No configured command" >&2
   exit 1
fi

export PATH=$PATH:@SIPX_BINDIR@:@SIPX_LIBEXECDIR@

CMD="$1"  # just the first word of the command

# Check if the command starts with an allowed command
if grep -q -E "^${CMD}" "$conf"; then
   exec "$@"
else
   echo "Command not allowed" >&2
   exit 1
fi