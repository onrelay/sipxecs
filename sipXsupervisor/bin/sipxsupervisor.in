#!/bin/bash
#
# sipxsupervisor         Start/Stop the cfengine server daemon.
#
# description: sipxsupervisor is responsible from giving out configuration files to
#              those cfengine clients, who wish to update their configs.
#              For more information, visit http://www.cfengine.org
# config: /var/cfengine/masterfiles

# Source function library.
. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

config="@SIPX_CFINPUTS@/sipxsupervisord.cf"
exec="/usr/local/sbin/cf-serverd"
prog=$(basename $exec)
progname="sipxsupervisor"
# used to tell which config is in use.
configid=/run/sipxsupervisor-configid
pidfolder="/run/sipxpbx/sipxsupervisor"
pidfile="$pidfolder/sipxsupervisor.pid"

[ -e /etc/sysconfig/sipxsupervisor ] && . /etc/sysconfig/sipxsupervisor

start() {
  [ -x $exec ] || { echo -n "$execError"; echo_failure; exit $ENOEXEC; }
  [ -f $config ] || { echo -n "$invalidFileError"; echo_failure; exit $ENOENT; }
  checkRunningProcess "${pidfile}" "${exec}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] && { echo -n "$prog $runningError"; echo_failure; exit $ERUNNING; }

  echo -n $config > $configid
  echo -n $"Starting $prog: "
  "$exec" -f "$config" > /dev/null 2>&1 & echo \$! > ${pidfile}
  Status=$?

  if [ $# -gt 0 ]; then
    checkRunningProcessTimeout "${pidfile}" "${exec}" $maxTimeout > /dev/null 2>&1
    Status=$?
    [ $Status -eq $ESRCH ] && { echo_failure; exit $ESRCH; }

    #sipxagent running
    checkIfProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
    Status=$?
    [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
    [ $Status -eq 0 ] && { echo_success; return $Status; }
  fi
  

  #if sipxagent is not running make sure the host is pulling the last configuration on startup.
  #this applies in cases when secondary host starts after master, and master changed configuration
  #while the secondary is down. sipxagent has to be run as root because we don't want to go through
  #supervisor again
  if [ ! -f "${pidfile}" ]; then
    runuser - root -s @SIPX_BINDIR@/sipxagent
    Status=$?

    if [ $# -gt 0 ]; then
      checkIfProcessIsListening "${pidfile}" "${exec}" > /dev/null 2>&1
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; return 0; }
    fi
  fi
}

nofork() {
  killAnyProcessOrphans "${pidfile}" "${exec}" 
  $exec -v -f $config
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${exec}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}


restart() {
  stop
  start $withCheck
}

asyncrestart() {
  stop
  start
}

restart() {
  stop
  start
}

reload() {
  restart
}

force_reload() {
  restart
}

case "$1" in
  start)
    start $withCheck
    ;;
  stop|restart|asyncrestart|reload|nofork)
    $1
    ;;
  force-reload)
    force_reload
    ;;
  status)
    checkRunningProcess "${pidfile}" "${exec}"
    ;;
  # condrestart - only restarts if service *is* running
  condrestart)
    checkRunningProcess "${pidfile}" "${exec}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] || restart
    ;;
  *)
    echo $"Usage: $0 {start|stop|status|restart|asyncrestartcondrestart|condstart|reload|force-reload|nofork}"
    exit $EINCORRECTUSAGE
esac
exit $?
