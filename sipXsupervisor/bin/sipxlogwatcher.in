#!/bin/bash
#
# sipxlogwatcher   Start and stop sipxecs logwatch based on SEC tool
#
# chkconfig:    35 91 80
# description:  Simple Event Correlator script to filter log file entries

. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

prog="sipxlogwatcher"
lockfile="/var/lock/subsys/sec"
pidfile=@SIPX_RUNDIR@/sipxlogwatcher/sipxlogwatcher.pid
rc=@SIPX_CONFDIR@/sipxlogwatcher-rc
regex="perl-$prog"
exec=`@SIPX_BINDIR@/sipx-config --perl --prog "${prog}"` 
exec="${exec} -w /usr/bin/sec"

[ -e $rc ] && . $rc

start() {
  checkRunningProcess "${pidfile}" "${regex}" > /dev/null 
  Status=$?
  [ $Status -eq 0 ] && { echo -n "$prog $runningError"; echo_failure; exit $ERUNNING; }

  for n in `seq 0 $((${#SEC_ARGS[*]} - 1))`; do
    echo -n $"Starting $prog "[$(($n + 1))]": "
    $exec ${SEC_ARGS[$n]} &
    Status=$?
    echo $! > ${pidfile}
    [ $Status -ne 0 ] && return $Status
    echo_success
  done
  touch $lockfile
  return $Status
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}

restart() {
  stop
  start
}

reload() {
  echo -n $"Reloading $progName: "
  pkill -HUP -f "$exec"
  RETVAL=$?
  echo
  return $RETVAL
}

force_reload() {
  restart
}

rh_status() {
  checkRunningProcess "${pidfile}" "${regex}"
}

rh_status_q() {
  rh_status >/dev/null 2>&1
}

dump() {
  echo -n $"Dumping state of $progName in /tmp/sec.dump: "
  pkill -USR1 -f "$exec"
  RETVAL=$?
  echo
  return $RETVAL
}

case "$1" in
  start)
    start
  ;;
  stop)
    stop
   ;;
  restart)
    restart
  ;;
  condrestart|try-restart)
    rh_status_q || exit 0
    restart
  ;;
  reload)
    reload
  ;;
  force-reload)
    force_reload
  ;;
  status)
    rh_status
  ;;
  dump)
    dump
  ;;
  *)
    echo $"Usage: $0 {start|stop|restart|condrestart|try-restart|reload|force-reload|status|dump}"
    exit $EINCORRECTUSAGE
esac

exit $?
