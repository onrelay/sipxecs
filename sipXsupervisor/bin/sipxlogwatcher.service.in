[Unit]
Description=logwatcher
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target

[Service]
Type=oneshot
ExecStart=@SIPX_SERVICEDIR@/sipxlogwatcher start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxlogwatcher stop
StandardOutput=journal

[Install]
WantedBy=multi-user.target
