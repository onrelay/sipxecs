[Unit]
Description=logwatcher
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxlogwatcher start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxlogwatcher stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxlogwatcher/sipxlogwatcher.pid

[Install]
WantedBy=multi-user.target
