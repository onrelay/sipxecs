[Unit]
Description=sipxtcpdumplog
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxtcpdumplog start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxtcpdumplog stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxtcpdumplog/sipxtcpdumplog.pid

[Install]
WantedBy=multi-user.target
