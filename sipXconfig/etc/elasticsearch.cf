#
# Elasticsearch configuration for working with sipxecs
#
bundle agent elasticsearch {

  classes:
    "elasticsearch" expression => "any";

  methods:
    primary::
      "any" usebundle => elasticsearch_snmp_wrapper;
      "any" usebundle => elasticsearch_config;
      "any" usebundle => elasticsearch_systemctl_running;
}

# --- Create Java wrapper for SNMP process tracking ---
bundle agent elasticsearch_snmp_wrapper {

  files:
    any::

      "/run/elasticsearch/."
        comment => "Ensure /run/elasticsearch exists",
        create => "true",
        perms => mog("755", "elasticsearch", "elasticsearch");

      "/run/elasticsearch/bin/."
        comment => "Ensure bin subfolder exists for ES_JAVA_HOME",
        create => "true",
        perms => mog("755", "elasticsearch", "elasticsearch");

      "/run/elasticsearch/bin/java"
        comment => "Wrapper to launch Elasticsearch Java via sipx-config",
        create => "true",
        perms => mog("755", "elasticsearch", "elasticsearch"),
        edit_line => elasticsearch_java_wrapper,
        classes => if_repaired("restart_elasticsearch");
}

# --- Wrapper content ---
bundle edit_line elasticsearch_java_wrapper {

  delete_lines:
    ".*";

  insert_lines:
    "#!/bin/bash
#
# Autogenerated wrapper for Elasticsearch Java
# Allows sipXecs SNMP process-name tracking
#

pidfile=\"/var/run/elasticsearch/elasticsearch.pid\"

JavaCmd=`/usr/bin/sipx-config --java --pidfile \"${pidfile}\"`

exec $JavaCmd \"$@\"
";
}

# --- Manage configuration files ---
bundle agent elasticsearch_config {

  files:
    any::
      "/etc/elasticsearch/elasticsearch.yml"
        comment => "Configure Elasticsearch (node-level settings only)",
        create => "true",
        perms => mog("644", "root", "root"),
        edit_line => elasticsearch_config_file,
        classes => if_repaired("restart_elasticsearch");

      "/etc/security/limits.d/99-elasticsearch-nproc.conf"
        comment => "Setup Elasticsearch limits",
        create => "true",
        perms => m("644"),
        edit_line => elasticsearch_limits_contents,
        classes => if_repaired("restart_elasticsearch");

      "/etc/elasticsearch/jvm.options"
        comment => "Configure JVM heap size for Elasticsearch",
        create => "true",
        perms => mog("644","root","root"),
        edit_line => elasticsearch_jvm_options,
        classes => if_repaired("restart_elasticsearch");

      # Systemd override to point to the wrapper Java
      "/etc/systemd/system/elasticsearch.service.d/snmp-override.conf"
        comment => "Point ES to the wrapper Java for SNMP tracking",
        create => "true",
        perms => mog("644", "root", "root"),
        edit_line => elasticsearch_systemd_override,
        classes => if_repaired("restart_elasticsearch");
}

# --- systemd override content ---
bundle edit_line elasticsearch_systemd_override {
  insert_lines:
    "[Service]
# Use wrapper Java for SNMP tracking
Environment=ES_JAVA_HOME=/run/elasticsearch
";
}

# --- nofile limits ---
bundle edit_line elasticsearch_limits_contents {
  insert_lines:
"elasticsearch soft    nofile    65536
elasticsearch hard    nofile    65536
";
}

# --- elasticsearch.yml content management ---
bundle edit_line elasticsearch_config_file {

  vars:
    "tmpDir" slist => readstringlist("$(sipx.SIPX_CFDATA)/$(sipx.location_id)/elasticsearch.yml.part", "tmpDir=", "\n", 1, 4000);

  delete_lines:
    any::
      "path.repo.*";
      "script.engine.groovy.inline.aggs.*";
      "cluster.name.*";
      "node.name.*";
      "index.number_of_replicas.*";
      "discovery.zen.ping.multicast.enabled.*";
      "cluster.initial_master_nodes.*";
      "network.host.*";
      "transport.host.*";
      "transport.bind_host.*";
      "transport.publish_host.*";
      "transport.port.*";
      "network.bind_host.*";
      "network.publish_host.*";
      "http.port.*";

      # Remove unused/unneeded X-Pack auto-settings
      "xpack.ml.enabled.*";
      "xpack.monitoring.enabled.*";
      "xpack.security.enabled.*";
      "xpack.security.transport.ssl.enabled.*";
      "xpack.security.http.ssl.enabled.*";

  insert_lines:
    any::

      # Repo locations
      "path.repo: [\"$(tmpDir)\", \"$(tmpDir)/elasticsearch_backup\"]";

      # Local single-node cluster, required for ES 8 when not running a real cluster
      "discovery.type: single-node";

      # Force IPv4-only and local-only (prevents [::1] binding errors)
      "network.host: 127.0.0.1";
      "network.bind_host: 127.0.0.1";
      "network.publish_host: 127.0.0.1";

      # Transport client compatibility
      "transport.host: 127.0.0.1";
      "transport.bind_host: 127.0.0.1";
      "transport.publish_host: 127.0.0.1";
      "transport.port: 9300";

      # HTTP REST API
      "http.port: 9200";

      # Disable unused X-Pack features
      "xpack.security.enabled: false";
      "xpack.ml.enabled: false";
}

# --- JVM options ---
bundle edit_line elasticsearch_jvm_options {

  delete_lines:
      "^-Xms.*";
      "^-Xmx.*";
      "^-Djava.net.preferIPv4Stack.*";

  insert_lines:
      "-Xms256m";
      "-Xmx512m";
      "-Djava.net.preferIPv4Stack=true";
}

bundle agent elasticsearch_systemctl_running {
  vars:
    any::
      "service" string => "elasticsearch.service";

  classes:
    any::
      "elasticsearch_running"
        expression => returnszero("$(sipx.systemctl) is-active $(service)","noshell");

  commands:
    (!elasticsearch|stop_sipxecs).elasticsearch_running::
      "$(sipx.systemctl)"
        comment => "stop elasticsearch",
        args => "stop $(service)";

      "$(sipx.systemctl)"
        comment => "disable elasticsearch",
        args => "disable $(service)";

    elasticsearch.!elasticsearch_running::
      "$(sipx.systemctl)"
        comment => "start elasticsearch",
        args => "start $(service)";

      "$(sipx.systemctl)"
        comment => "enable elasticsearch",
        args => "enable $(service)";

    elasticsearch.elasticsearch_running.restart_elasticsearch::
      "$(sipx.systemctl)"
        comment => "restart elasticsearch",
        args => "restart $(service)";
}