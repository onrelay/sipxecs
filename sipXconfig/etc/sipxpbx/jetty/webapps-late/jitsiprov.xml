<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">
<Configure class="org.eclipse.jetty.ee10.webapp.WebAppContext">
  <Set name="contextPath">/jitsiprov</Set>
  <Set name="war"><SystemProperty name="jetty.lib.dir"/>/jitsiprov.war</Set>
  <Set name="extractWAR">true</Set>
  <Set name="tempDirectory"><SystemProperty name="jetty.tmp.dir"/>/jitsiprov</Set>
  <Set name="crossContextDispatchSupported">true</Set>
</Configure>