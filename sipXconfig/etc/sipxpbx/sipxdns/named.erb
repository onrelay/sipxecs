<%
#  This file is Ruby ERB template that generate named.conf.  Because
#  ERB format look a lot like the config file it's generating this can
#  be tricky to edit particulary to track which } goes with which syntax
#  so be sure to test your changes.
%>
// WARNING: Name server configuration is a sipXecs automatically generated file.
logging { 
  category queries { 
    null; 
  }; 
  category lame-servers { 
    null; 
  }; 
  category security { 
    null; 
  }; 
};

<% unless acl.nil? %>
acl corpnets { <%= acl %> };
<% end %>

options {
  directory  "/var/named";
  dump-file "/var/named/data/cache_dump.db";
  statistics-file "/var/named/data/named_stats.txt";
<% unless acl.nil? %>
  allow-query { any; };
  allow-recursion { corpnets; };
<% end %>
  filter-aaaa-on-v4 yes;

  forwarders {
<% if forwarders && forwarders.respond_to?(:each) %>
<% forwarders.each do |forwarder| %>
    <%= forwarder %>;
<% end %>
<% end %>
  };
};

<% if views && views.respond_to?(:each) %>
<% views.each do |view| %>
view <%= view[:name] %> {
<% if view[:match_clients] %>
  match-clients {
<% view[:match_clients].each do |ipaddr| %>
    <%= ipaddr %>;
<% end %>
  };
<% end %>

  zone "<%= domain %>" IN {
    type master;
    file "<%= view[:name] %>.<%= domain %>.zone";
    allow-update {
      none;
    };
  };
};
<% end %>
<% end %>