#
# sipxconfig tftp configuration 
#
bundle agent tftp {
  methods:
    primary::
      "any" usebundle => tftp_config;
      "any" usebundle => tftpd_systemctl_running;
}

bundle agent tftp_config {
  vars:
    "rootdir" string => "$(sipx.SIPX_VARDIR)/configserver/phone/profile/tftproot --blocksize 1300";

  files:
    "/etc/systemd/system/tftp.service.d/override.conf"
      comment => "Set custom tftp root directory and blocksize safely via multi-line array",
      create => "true",
      perms => m("644"),
      edit_line => tftp_systemd_override("$(rootdir)"),
      classes => if_repaired("systemd_reload");
}

bundle edit_line tftp_systemd_override(rootdir) {
  vars:
    # Storing the exact text structure in a variable list isolates it from the parser rules
    "lines" slist => {
      "[Service]",
      "ExecStart=",
      "ExecStart=/usr/sbin/in.tftpd -s $(rootdir)"
    };

  insert_lines:
    "$(lines)";
}

bundle agent tftpd_systemctl_running {
  vars:
    any::
      "socket_service" string => "tftp.socket";

  classes:
    any::
      "tftp_socket_running" 
        expression => returnszero("$(sipx.systemctl) is-active $(socket_service)", "noshell");

  commands:
    systemd_reload::
      "$(sipx.systemctl)"
        comment => "reload systemd configuration",
        args => "daemon-reload";

    !tftp_socket_running::
      "$(sipx.systemctl)"
        comment => "start tftp socket",
        args => "start $(socket_service)";

      "$(sipx.systemctl)"
        comment => "enable tftp socket",
        args => "enable $(socket_service)";

    tftp_socket_running.systemd_reload::
      "$(sipx.systemctl)"
        comment => "restart tftp socket to apply configuration changes",
        args => "restart $(socket_service)";
}