ln -sfn ../../../../../usr/share/java/sipXecs/sipXcommons/micrometer-observation-*.jar %{buildroot}%{sipxpbxconf}/jetty/lib/ext/
ln -sfn ../../../../../usr/share/java/sipXecs/sipXcommons/spring-*.jar %{buildroot}%{sipxpbxconf}/jetty/lib/ext/
