RepoName=sipXconfig
sipXconfig_dependency() {
  case $1 in
  tapestry-contrib*)
    pkg_push commons-io;;
  sipxconfig-test)
    # packages that sipxconfig related unit tests will need to add to classpath
    pkg_push \
       cglib-nodep \
       commons-beanutils-core \
       commons-collections \
       commons-digester \
       commons-logging \
       dbunit \
       dom4j \
       easymock \
       hibernate \
       jakarta.servlet \
       jaxen \
       junit \
       org.restlet \
       spring-context \
       spring-context-support \
       spring-core \
       spring-orm \
       spring-tx \
       sipxcommons \
       velocity \
       velocity-tools-generic \
       xercesImpl \
       xmlunit
    return 1;;
  esac
}
