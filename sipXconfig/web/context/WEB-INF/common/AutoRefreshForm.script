<?xml version="1.0"?>
<!DOCTYPE script PUBLIC
	"-//Apache Software Foundation//Tapestry Script Specification 3.0//EN"
	"http://jakarta.apache.org/tapestry/dtd/Script_3_0.dtd">
<script>
  <input-symbol key="refreshButton" required="yes"/>
  <input-symbol key="interval" required="yes"/>
  <input-symbol key="checkbox" required="yes" />
  <input-symbol key="stopOnError" required="yes" />
  
  <let key="initRefresh" unique="yes">initRefresh</let>
  <let key="timeoutId" unique="yes">timeoutId</let>
  
  <body>
    <unique>
      <![CDATA[    
        var refreshEnabled = true;
        var stopOnError = ${stopOnError};  // keep dynamic value from template

        var refreshEventTarget = new EventTarget();

        function updateRefresh(value) {
            console.log("Updating auto refresh interval: " + value.message);
            initRefresh("refreshForm", value.message);
        }

        function initRefresh(formId, intervalSeconds, checkboxId = "${checkbox}", timeoutVarName = "${timeoutId}") {
            console.log("Registering auto refresh: " + intervalSeconds);

            var clickFn = function() {
                var checkbox = document.getElementById(checkboxId);
                var form = document.getElementById(formId);
                var errorElement = document.getElementById("user:error");

                if (!checkbox || !form) return;

                if (checkbox.checked && refreshEnabled) {
                    if (stopOnError && errorElement) {
                        console.log("Error on page - no refresh");
                        checkbox.checked = false;
                    } else {
                        refresh();
                    }
                }
            };

            // Clear previous interval if exists
            if (window[timeoutVarName]) {
                console.log('Clearing interval: ' + window[timeoutVarName]);
                clearInterval(window[timeoutVarName]);
                window[timeoutVarName] = 0;
            } else {
                console.log('Previous interval 0 or undefined');
            }

            // Set new interval in milliseconds
            window[timeoutVarName] = setInterval(clickFn, intervalSeconds * 1000);
            console.log('Setting interval: ' + window[timeoutVarName]);
        }

        function setRefreshInterval(newInterval) {
            refreshEventTarget.dispatchEvent(new CustomEvent('refreshInterval', { detail: { message: newInterval } }));
        }

        // Allow other code to "subscribe" to interval changes
        function onRefreshInterval(callback) {
            refreshEventTarget.addEventListener('refreshInterval', function(event) {
                callback(event.detail);
            });
        }

        function refresh() {
            var refreshBtn = document.getElementById('refresh'); 
            
            if (refreshBtn) {
                refreshBtn.click(); 
            } else {
                var form = document.getElementById('refreshForm');
                if (form) {
                    form.submit();
                }
            }
        }

      ]]>
    </unique>
  </body>

  <initialization>
    // Initialize refresh with current interval
    ${initRefresh}("refreshForm", ${interval});

    // Subscribe to updates 
    onRefreshInterval(updateRefresh);
  </initialization>
</script>