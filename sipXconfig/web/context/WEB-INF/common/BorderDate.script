<?xml version="1.0"?>
<!DOCTYPE script PUBLIC
	"-//Apache Software Foundation//Tapestry Script Specification 3.0//EN"
	"http://jakarta.apache.org/tapestry/dtd/Script_3_0.dtd">
<script>

<input-symbol key="date" class="java.lang.String" required="yes"/>

<body>
<![CDATA[
var currentDate = new Date("${date}");
var interval = 10000;

const formatter = new Intl.DateTimeFormat(undefined, {
    weekday: 'short',   // EEE
    day: '2-digit',     // dd
    month: 'short',     // MMM
    year: 'numeric',    // yyyy
    hour: 'numeric',    // h
    minute: '2-digit',  // mm
    hour12: true        // aa (AM/PM)
});

function updateDate() {
    const targetNode = document.getElementById("dateComponent");
    if (!targetNode) return;

    targetNode.textContent = formatter.format(currentDate);

    currentDate = new Date(currentDate.getTime() + interval);
    setTimeout(updateDate, interval);
}

// Run when DOM is ready
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateDate);
} else {
    updateDate();
}
]]>
</body>
</script>