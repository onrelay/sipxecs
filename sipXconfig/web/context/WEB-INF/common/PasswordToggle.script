<?xml version="1.0"?>
<!DOCTYPE script PUBLIC
	"-//Apache Software Foundation//Tapestry Script Specification 3.0//EN"
	"http://jakarta.apache.org/tapestry/dtd/Script_3_0.dtd">
<script>

<body>
<![CDATA[
  (function() {
    'use strict';

    function initPasswordToggles() {
      var passwordInputs = document.querySelectorAll('input[type="password"]');
      passwordInputs.forEach(function(input) {
        if (input.dataset.pwToggle === '1') return;

        var parent = input.parentNode;
        try {
          var parentPos = window.getComputedStyle(parent).position;
          if (!parentPos || parentPos === 'static') {
            parent.style.position = 'relative';
          }
        } catch (e) {
          // ignore computed style errors
        }

        input.classList.add('password-with-toggle');

        var button = document.createElement('button');
        button.type = 'button';
        button.className = 'password-toggle password-hidden';
        button.title = 'Toggle password visibility';
        button.setAttribute('aria-label', 'Show password');
        button.style.margin = '0';
        button.style.padding = '0';

        button.innerHTML = `
          <svg class="password-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <!-- Open Eye Path -->
            <path class="eye-open" d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
            <circle class="eye-open" cx="12" cy="12" r="3" />
            
            <!-- Closed Eye (Slash) Path -->
            <path class="eye-closed" d="M9.88 9.88a3 3 0 1 0 4.24 4.24M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68M6.61 6.61A13.52 13.52 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61M2 2l20 20" />
          </svg>
        `;
        parent.insertBefore(button, input.nextSibling);

        // Initialize icon state according to current input.type
        var open = button.querySelector('.eye-open');
        var closed = button.querySelector('.eye-closed');
        if (input.type === 'password') {
          if (open) open.style.display = 'none';
          if (closed) closed.style.display = '';
          button.classList.add('password-hidden');
          button.classList.remove('password-visible');
          button.setAttribute('aria-label', 'Show password');
        } else {
          if (open) open.style.display = '';
          if (closed) closed.style.display = 'none';
          button.classList.add('password-visible');
          button.classList.remove('password-hidden');
          button.setAttribute('aria-label', 'Hide password');
        }

        button.addEventListener('click', function(e) {
          e.preventDefault();
          togglePasswordVisibility(input, button);
        });

        input.dataset.pwToggle = '1';
      });
    }

    function togglePasswordVisibility(input, button) {
      var open = button.querySelector('.eye-open');
      var closed = button.querySelector('.eye-closed');
      if (input.type === 'password') {
        // Show password
        input.type = 'text';
        if (open) open.style.display = '';
        if (closed) closed.style.display = 'none';
        button.classList.add('password-visible');
        button.classList.remove('password-hidden');
        button.setAttribute('aria-label', 'Hide password');
      } else {
        // Hide password
        input.type = 'password';
        if (open) open.style.display = 'none';
        if (closed) closed.style.display = '';
        button.classList.add('password-hidden');
        button.classList.remove('password-visible');
        button.setAttribute('aria-label', 'Show password');
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPasswordToggles);
    } else {
      initPasswordToggles();
    }
  })();
]]>
</body>
<initialization>
</initialization>
</script>