<?xml version="1.0"?>
<!DOCTYPE script PUBLIC
	"-//Apache Software Foundation//Tapestry Script Specification 3.0//EN"
	"http://jakarta.apache.org/tapestry/dtd/Script_3_0.dtd">
<script>
<body>
<![CDATA[
var waitForServerDown = true;
var timeToExpire = 0;
var interval = 5000; // 5 seconds
var timeoutLimit = 1800000; // 30 minutes
var targetUrl = location.href;

// Construct base URL
function getUrlBase() {
    var host = location.host;
    var pos = host.indexOf(":");
    return pos !== -1 ? host.substr(0, pos) : host;
}
var base_url = "http://" + getUrlBase() + "/sipxconfig/rest/my/logoutunite";

// Modern AJAX polling function
function makeRequest() {
    fetch(targetUrl, { cache: "no-store" })
        .then(response => {
            if (!response.ok) throw new Error("Server not ready");
            return response.text();
        })
        .then(data => onLoad(data))
        .catch(error => onError(error));
}

// Handle successful response
function onLoad(data) {
    if (waitForServerDown) {
        if (timeToExpire > timeoutLimit) {
            alert("Timeout expired. Server is not down.");
            window.location = base_url;
        } else {
            timeToExpire += interval;
            setTimeout(makeRequest, interval);
        }
    } else {
        window.location = base_url;
    }
}

// Handle error response
function onError(error) {
    waitForServerDown = false;
    setTimeout(makeRequest, interval);
}

// Placeholder if needed
function onWaitingListenerResponse() {
    // no-op
}

// Optional: trigger any listener you had in original code
function triggerWaitingListener() {
    onWaitingListenerResponse();
}
]]>
</body>

<initialization>
   makeRequest();
   triggerWaitingListener();
</initialization>
</script>