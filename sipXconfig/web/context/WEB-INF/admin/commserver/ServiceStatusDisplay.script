<?xml version="1.0"?>
<!DOCTYPE script PUBLIC
    "-//Apache Software Foundation//Tapestry Script Specification 3.0//EN"
    "http://jakarta.apache.org/tapestry/dtd/Script_3_0.dtd">
<script>
    <input-symbol key="rowId" required="yes" />
    <input-symbol key="showDetailsLabel" required="yes" />
    <input-symbol key="hideDetailsLabel" required="yes" />
    
    <body>
        <unique>
	    <![CDATA[
            const visible = {};

            function loadDetails(link, rowId) {
                showLoadingIcon(rowId);
                showMessageArea(rowId);
                visible[rowId] = true;
            }

            function toggleDetails(link, rowId, showLabel = "${showDetailsLabel}", hideLabel = "${hideDetailsLabel}") {
                if (visible[rowId]) {
                    hideMessageArea(rowId);
                    link.innerHTML = showLabel;
                    visible[rowId] = false;
                } else {
                    showMessageArea(rowId);
                    link.innerHTML = hideLabel;
                    visible[rowId] = true;
                }
            }

            function showLoadingIcon(rowId) {
                const loadingIcon = document.getElementById("loadingIcon-" + rowId);
                if (loadingIcon) {
                    loadingIcon.style.display = "inline";
                }
            }

            function hideLoadingIcon(rowId) {
                const loadingIcon = document.getElementById("loadingIcon-" + rowId);
                if (loadingIcon) {
                    loadingIcon.style.display = "none";
                }
            }

            function showMessageArea(rowId) {
                const messageArea = document.getElementById("messageDetail-" + rowId);
                if (messageArea) {
                    messageArea.style.display = "block";
                    messageArea.style.height = "0px";
                    const fullHeight = messageArea.scrollHeight + "px";
                    messageArea.style.transition = "height 0.25s ease";
                    requestAnimationFrame(() => {
                        messageArea.style.height = fullHeight;
                    });
                    messageArea.addEventListener("transitionend", function handler() {
                        messageArea.style.height = "auto"; // allow flexible height after animation
                        messageArea.removeEventListener("transitionend", handler);
                    });
                }
            }

            function hideMessageArea(rowId) {
                const messageArea = document.getElementById("messageDetail-" + rowId);
                if (messageArea) {
                    const fullHeight = messageArea.scrollHeight + "px";
                    messageArea.style.height = fullHeight; // set current height for transition
                    requestAnimationFrame(() => {
                        messageArea.style.transition = "height 0.25s ease";
                        messageArea.style.height = "0px";
                    });
                    messageArea.addEventListener("transitionend", function handler() {
                        messageArea.style.display = "none";
                        messageArea.removeEventListener("transitionend", handler);
                    });
                }
            }
	    ]]>
        </unique>
    </body>
    
    <initialization>
        <![CDATA[
            visible[${rowId}] = false;        
        ]]>
    </initialization>
    
</script>
