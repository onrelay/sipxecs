[Unit]
Description=Mongodb sync
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target mongod.service
Requires=mongod.service

[Service]
Type=oneshot
ExecStart=@SIPX_SERVICEDIR@/mongodb-sync start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/mongodb-sync stop
StandardOutput=journal

[Install]
WantedBy=multi-user.target
