#! /bin/sh
#
# freeswitch:       Starts the freeswitch Daemon
#
# processname: freeswitch
# description: Freeswitch fedora init script \
# config:
# Author: gled

. /etc/sysconfig/network
. @SIPX_LIBEXECDIR@/sipx-utils.sh || { echo_failure; exit $ENOENT; }

PATH=/sbin:/usr/sbin:/bin:/usr/bin:@FREESWITCH_PREFIX@/bin
DESC="FreeSwitch Voice Switching System"
NAME=freeswitch
DAEMON=$NAME
FS_USER=freeswitch
FS_GROUP=daemon
FS_CLI=fs_cli
DAEMON_ARGS="\
  -conf @SIPX_FSCONFDIR@/sipxpbx/conf \
  -db @SIPX_FSDBDIR@ \
  -log @SIPX_FSLOGDIR@ \
  -run @SIPX_FSRUNDIR@ \
  -htdocs @SIPX_FSCONFDIR@/sipxpbx/conf/htdoc"
DAEMON_START_ARGS="-nc -nonat \
  -u $FS_USER \
  -g $FS_GROUP \
   $DAEMON_ARGS"
DAEMON_STOP_ARGS="-stop \
   $DAEMON_ARGS"
PIDFILE=@SIPX_FSRUNDIR@/freeswitch.pid

do_setlimits() {
        ulimit -c unlimited
        ulimit -d unlimited
        ulimit -f unlimited
        ulimit -i unlimited
        ulimit -n 999999
        ulimit -q unlimited
        ulimit -u unlimited
        ulimit -v unlimited
        ulimit -x unlimited
        ulimit -s 240
        ulimit -l unlimited
        return 0
}

do_permission_check() {
  # Ensure that important FreeSWITCH files are writeable by freeswitch
  FS_DBDIR=@SIPX_FSDBDIR@
  if test ! -e $FS_DBDIR
  then
    mkdir $FS_DBDIR
    chown -R $FS_USER:$FS_GROUP $FS_DBDIR
    chmod -R u+rwX,ga+rX $FS_DBDIR
  fi
  FS_RUNDIR=@SIPX_FSRUNDIR@
  if test ! -e $FS_RUNDIR
  then
    mkdir $FS_RUNDIR
    chown -R $FS_USER:$FS_GROUP $FS_RUNDIR
    chmod -R u+rwX,ga+rX $FS_RUNDIR
  fi
  FS_LOGDIR=@SIPX_FSLOGDIR@
  if test ! -e $FS_LOGDIR
  then
    mkdir $FS_LOGDIR
    chown -R $FS_USER:$FS_GROUP $FS_LOGDIR
    chmod -R u+rwX,ga+rX $FS_LOGDIR
  fi
  FS_CONFDIR=@SIPX_FSCONFDIR@
  if test ! -e $FS_CONFDIR
  then
    mkdir $FS_CONFDIR
    chown -R $FS_USER:$FS_GROUP $FS_CONFDIR
    chmod -R u+rwX,ga+rX $FS_CONFDIR
  fi
}

do_audio_setup() {
  # Ensure that the audio devices are owned by freeswitch
  # This is required for proper FreeSWITCH operation.
  for dev in /dev/adsp /dev/audio /dev/dsp /dev/mixer /dev/sequencer /dev/sequencer2 ; do
    if test -e $dev
    then
        chown $FS_USER $dev
    fi
  done

  # If alsa present configure the sound input source used for MOH to be 'Line'
  if test -d /dev/snd
  then
    chown $FS_USER /dev/snd/*
    amixer cset iface=MIXER,name="Input Source",index=0 "Line" >& /dev/null
    amixer cset iface=MIXER,name="Capture Switch",index=0 on >& /dev/null
    amixer cset iface=MIXER,name="Capture Volume",index=0 60% >& /dev/null
  fi
}

base=${0##*/}

do_start() {
  checkRunningProcessIsListening $PIDFILE > /dev/null
  RETVAL=$?
  [ $RETVAL -eq 0 ] && { echo -n "$NAME $runningError"; echo_failure; exit $ERUNNING; }
  do_setlimits
  do_permission_check
  do_audio_setup
  $DAEMON $DAEMON_START_ARGS
  RETVAL=$?

  if [ $# -gt 0 ]; then
    #check if process spawned
    checkRunningProcessTimeout $PIDFILE
    RETVAL=$?
    [ $RETVAL -eq 0 ] || { echo_failure; exit $ESRCH; }
    checkIfProcessIsListening $PIDFILE
    RETVAL=$?
    [ $RETVAL -eq 0 ] || { echo_failure; exit $ENOSCKT; }
    [ $RETVAL -eq 0 ] && { echo_success; }
  else
    [ $RETVAL -eq 0 ] && { echo_success; }
    [ $RETVAL -eq 0 ] || { echo_failure; }
    return $RETVAL
  fi
}

do_kill() {
  if [ -f "$PIDFILE" ]; then
      pid=$(cat "$PIDFILE")
      if kill -0 "$pid" 2>/dev/null; then
          kill -TERM "$pid"
      fi
  fi
}

do_stop() {
  fspid=$(pgrep -x "$NAME")
  status=$?
  $DAEMON $DAEMON_STOP_ARGS
  RETVAL=$?
  if [ "$RETVAL" -eq 0 ]; then
    echo "$base shutdown: success"
  else
    echo "$base shutdown: failed"
  fi
  echo "Waiting for daemon to exit..."
  i=0
  while [[ $status -lt 1 && $i -lt 10 ]]
    do
    sleep 1
      fspid=$(pgrep -x "$NAME")
  status=$?
  i=$(expr $i + 1)
  done
  if [ $status -lt 1 ]; then
    echo "Process did not exit cleanly. Aborting..."
    do_kill
  fi
  rm -f $LOCKFILE
  echo
  return $RETVAL
}


do_reload() {
  $FS_CLI -x "reloadXml"
  RETVAL=$?
  echo
  return $RETVAL
}

do_restart() {
  do_stop
  do_start $withCheck
}

do_asyncrestart() {
  do_stop
  do_start
}

# See how we were called.
case "$1" in
  start)
    do_start $withCheck
    ;;
  stop)
    do_stop
    ;;
  reload)
    do_reload
    ;;
  restart)
    do_restart
    ;;
  asyncrestart)
    do_asyncrestart
    ;;
  status)
    checkRunningProcessIsListening $PIDFILE
    ;;
  *)
    echo $"Usage: $0 {start|stop|status}"
    exit $EINCORRECTUSAGE
    ;;
esac

exit $RETVAL
