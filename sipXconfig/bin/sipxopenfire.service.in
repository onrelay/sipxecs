[Unit]
Description=sipX Openfire XMPP Server
After=network.target syslog.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/sysconfig/openfire
ExecStart=/etc/init.d/openfire start
ExecStop=/etc/init.d/openfire stop
ExecReload=/etc/init.d/openfire restart
PIDFile=/var/run/openfire.pid

[Install]
WantedBy=multi-user.target