[Unit]
Description=Mongod arbiter
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target mongod.service
Requires=mongod.service

[Service]
Type=oneshot
ExecStart=@SIPX_SERVICEDIR@/mongod-arbiter start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/mongod-arbiter stop
StandardOutput=journal

[Install]
WantedBy=multi-user.target
