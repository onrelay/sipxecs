[Unit]
Description=sipxconfig
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
# see man systemd.service
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxconfig start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxconfig stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxconfig/sipxconfig.pid

[Install]
WantedBy=multi-user.target
