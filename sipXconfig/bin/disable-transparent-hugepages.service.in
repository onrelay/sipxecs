[Unit]
Description=Disable Transparent Hugepages
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target postgresql.service 
Requires=postgresql.service 

[Service]
Type=oneshot
ExecStart=@SIPX_SERVICEDIR@/disable-transparent-hugepages start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/disable-transparent-hugepages stop
StandardOutput=journal

[Install]
WantedBy=multi-user.target
