[Unit]
Description=Mongo local
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target mongod.service
Requires=mongod.service

[Service]
Type=oneshot
ExecStart=@SIPX_SERVICEDIR@/mongo-local start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/mongo-local stop
StandardOutput=journal

[Install]
WantedBy=multi-user.target
