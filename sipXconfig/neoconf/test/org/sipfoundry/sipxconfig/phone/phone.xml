<?xml version="1.0"?>
<!DOCTYPE model 
    PUBLIC "-//sipXconfig//Model specification 2.0//EN" 
    "/etc/sipxpbx/setting.dtd">
<model>
  <group name="server">
    <label>Servers</label>
    <setting name="outboundProxy">
      <label>Outbound Proxy</label>
      <value/>
    </setting>
    <setting name="outboundProxyPort">
      <label>Outbound Proxy Port</label>
      <value/>
    </setting>
    <setting name="tftpServer">
      <label>TFTP Server</label>
      <value/>
    </setting>
  </group>
  <group name="system">
    <label>System</label>
    <setting name="domainName">
      <label>Domain Name</label>
      <value/>
    </setting>
    <setting name="voiceMailNumber">
      <label>Voicemail Number</label>
      <value/>
    </setting>    
  </group>    
  <group name="e911" hidden="yes">
    <setting name="location">
      <type>
        <integer/>
      </type>
    </setting>    
  </group>
</model>
