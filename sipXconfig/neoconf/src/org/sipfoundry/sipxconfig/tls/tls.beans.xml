<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <!--
    - TLS Peer
  -->
  <bean id="tlsPeerManagerImpl" class="org.sipfoundry.sipxconfig.tls.TlsPeerManagerImpl" parent="daoSupport">
    <property name="coreContext" ref="coreContext" />
  </bean>

  <bean id="tlsPeerManager" class="org.springframework.aop.framework.ProxyFactoryBean" parent="proxySupport">
    <property name="proxyInterfaces" value="org.sipfoundry.sipxconfig.tls.TlsPeerManager" />
    <property name="target" ref="tlsPeerManagerImpl" />
  </bean>
</beans>
