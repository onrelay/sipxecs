<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
	"http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.sipfoundry.sipxconfig.localization" default-lazy="false">
  <class name="Localization" table="localization">
    <id name="id" column="localization_id" type="int" unsaved-value="-1">
       <generator class="org.hibernate.id.enhanced.SequenceStyleGenerator">
        <param name="sequence_name">localization_seq</param>
        <param name="increment_size">1</param>
      </generator>    
    </id>
    <property name="region" />
    <property name="language" />
  </class>

</hibernate-mapping>
