<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="speedDialManager" class="org.springframework.aop.framework.ProxyFactoryBean"
    parent="proxySupport">
    <property name="proxyInterfaces">
      <value>org.sipfoundry.sipxconfig.speeddial.SpeedDialManager</value>
    </property>
    <property name="target">
      <ref bean="speedDialManagerImpl" />
    </property>
  </bean>

  <bean id="speedDialManagerImpl" class="org.sipfoundry.sipxconfig.speeddial.SpeedDialManagerImpl" parent="daoSupport">
    <property name="coreContext" ref="coreContext" />
    <property name="featureManager" ref="featureManager" />
    <property name="configManager" ref="configManager" />
    <property name="featureId" value="rls"/>
    <property name="validUsers" ref="validUsers" />
    <property name="aliasManager" ref="aliasManagerImpl" />
    <property name="sipxReplicationContext" ref="sipxReplicationContext" />
    <property name="imdbTemplate" ref="imdb"/>
    <property name="adminContext" ref="adminContext"/>
  </bean>

  <bean id="speedDialOnEdit" class="org.sipfoundry.sipxconfig.speeddial.SpeadDialOnEdit">
    <property name="speedDialManager" ref="speedDialManager"/>
  </bean>

</beans>
