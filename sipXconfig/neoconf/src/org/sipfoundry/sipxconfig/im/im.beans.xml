<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="imManager" class="org.springframework.aop.framework.ProxyFactoryBean" parent="proxySupport">
    <property name="target" ref="skeletonImManagerImpl"/>
    <property name="proxyInterfaces" value="org.sipfoundry.sipxconfig.im.ImManager"/>
  </bean>

  <bean id="skeletonImManagerImpl" class="org.sipfoundry.sipxconfig.im.SkeletonImManagerImpl">
    <property name="settingsDao">
      <bean parent="beanWithSettingsDao">
        <property name="target">
          <bean parent="beanWithSettingsDaoImpl">
            <constructor-arg value="org.sipfoundry.sipxconfig.im.ImSettings"/>
          </bean>
        </property>
      </bean>
    </property>
    <property name="featureManager" ref="featureManager" />
  </bean>

  <bean id="imSettings" class="org.sipfoundry.sipxconfig.im.ImSettings" parent="settingsBean">
  </bean>

</beans>
