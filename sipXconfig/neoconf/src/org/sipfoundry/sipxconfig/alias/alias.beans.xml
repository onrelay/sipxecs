<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <!--
  - A L I A S  M A N A G E R
  -->

  <bean id="aliasManagerImpl" class="org.sipfoundry.sipxconfig.alias.AliasManagerImpl" parent="daoSupport">
  </bean>

  <bean id="aliasManager" class="org.springframework.aop.framework.ProxyFactoryBean" parent="proxySupport">
    <property name="proxyInterfaces">
      <value>org.sipfoundry.sipxconfig.alias.AliasManager</value>
    </property>
    <property name="target" ref="aliasManagerImpl"/>
  </bean>

</beans>
