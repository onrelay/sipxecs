<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
  "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">
<hibernate-mapping package="org.sipfoundry.sipxconfig.feature" default-lazy="false">

  <sql-query name="locationsForEnabledFeature">
    <return alias="loc" class="org.sipfoundry.sipxconfig.commserver.Location"/>
    <![CDATA[
      select loc.* 
        from location loc 
        inner join feature_local fl on loc.location_id = fl.location_id 
      where 
        fl.feature_id = :featureId
    ]]>
  </sql-query>

</hibernate-mapping>
