[Unit]
Description=sipxrest
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxrest start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxrest stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxrest/sipxrest.pid

[Install]
WantedBy=multi-user.target
