#!/bin/bash

# sipXrest - Startup script for sipxrest
# chkconfig: 35 97 15
# description: sipxrest is web service for 3ppc and cdrlog apis
# processname: sipxrest

# Copyright (C) 2012 eZuce Inc., certain elements licensed under a Contributor Agreement.
# Contributors retain copyright to elements licensed under a Contributor Agreement.
# Licensed to the User under the AGPL license.

. @SIPX_LIBEXECDIR@/sipx-utils.sh || exit 1

prog=sipxrest
pidfile="@SIPX_RUNDIR@/sipxrest/sipxrest.pid"
regex="java-$prog"

[ -e @SIPX_CONFDIR@/sysconfig/$prog ] && . @SIPX_CONFDIR@/sysconfig/$prog

# Start sipxrest
start() {
  checkRunningProcess "${pidfile}" "${regex}" > /dev/null
  Args=""
  JavaCmd=`@SIPX_BINDIR@/sipx-config --java --pidfile "${pidfile}"`
  Dependencies=`@SIPX_BINDIR@/java-dep -d @SIPX_JAVADIR@/sipXcommons @rest_PKGS@`
  export CLASSPATH=`echo @SIPX_CONFDIR@/sipxrest @SIPX_JAVADIR@/sipXrest/*.jar @SIPX_JAVADIR@/sipXrest/plugins/*.jar ${Dependencies} | sed -e 's/ /:/g'`    
  
  Command="$JavaCmd \
      -Dconf.dir=@SIPX_CONFDIR@	\
      -Dplugin.dir=@SIPX_JAVADIR@/sipXrest/plugins \
	    -Dorg.apache.commons.logging.Log=org.apache.commons.logging.impl.Log4JLogger \
      -Dsipxrest.command=start \
      org.sipfoundry.sipxrest.RestServer \
	 $Args"

  if [ -n "${NoFork}" ] ; then
    killAnyProcessOrphans "${pidfile}" "${regex}"
    runuser -s /bin/bash @SIPXPBXUSER@ -c ${Command}
  else
    checkRunningProcess "${pidfile}" "${regex}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && { echo_running; exit $ERUNNING; }
    
    echo -n $"Starting $prog: "
    runuser -s /bin/bash @SIPXPBXUSER@ -c "${Command} > /dev/null 2>&1 & echo \$!" > ${pidfile}
    Status=$?

    if [ $# -gt 0 ]; then
      #check if process was spawned
      checkRunningProcessTimeout "${pidfile}" "${regex}"
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ESRCH; }
      checkRunningProcess "${pidfile}" "${regex}" > /dev/null
      Status=$?
      [ $Status -eq 0 ] || { echo_failure; exit $ENOSCKT; }
      [ $Status -eq 0 ] && { echo_success; }
    else
      [ $Status -eq 0 ] || { echo_failure; }
      [ $Status -eq 0 ] && { echo_success; }
    fi
  fi
}

stop() {
  echo -n $"Stopping $prog: "
  killAnyProcessOrphans "${pidfile}" "${regex}" > /dev/null 2>&1
  Status=$?
  [ $Status -eq 0 ] || { echo_failure; }
  [ $Status -eq 0 ] && { echo_success; }
}

restart() {
    stop
    # sleep for no good reason. Can be disconcerting if stop/start
    # switch is too fast IMHO
    sleep 1
    start
}

case "$1" in
  nofork)
    NoFork=1
    start
    ;;
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart|reload|force-reload)
    restart
    ;;
  condrestart)
    checkRunningProcessIsListening "${pidfile}" "${regex}" > /dev/null
    Status=$?
    [ $Status -eq 0 ] && restart || :
    ;;
  status)
    checkRunningProcessIsListening "${pidfile}" "${regex}"
    ;;
  configtest)
    configtest
    ;;
  *)
	echo "Usage: $0 {start|stop|status|restart|reload|force-reload|condrestart|nofork}"
    Status=1
esac

exit $Status