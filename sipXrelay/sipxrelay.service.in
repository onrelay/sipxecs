[Unit]
Description=sipxrelay
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxrelay start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxrelay stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxrelay/sipxrelay.pid

[Install]
WantedBy=multi-user.target
