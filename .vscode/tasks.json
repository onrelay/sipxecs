{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run sipXclient dev server",
      "type": "shell",
      "command": "./node_modules/.bin/vite",
      "args": ["--host", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}/sipXclient/webapp"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Build sipXdao packages locally",
      "type": "shell",
      "command": "/bin/zsh",
      "args": ["-lc", "pnpm install --no-frozen-lockfile && pnpm build"],
      "options": {
        "cwd": "${workspaceFolder}/sipXdao"
      },
      "isBackground": false,
      "problemMatcher": [],
      "group": "build"
    }
  ]
}
