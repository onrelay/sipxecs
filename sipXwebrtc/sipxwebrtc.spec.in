Name: @PACKAGE@
Version: @VERSION@
Release: @PACKAGE_REVISION@

Summary: sipXwebrtc WebRTC server integration for FreeSWITCH
License: LGPL
Group: Applications/Communications
Vendor: SIPfoundry
Url: http://www.sipfoundry.org

%define debug_package %{nil}

BuildRequires: automake
BuildRequires: libxml2
BuildRequires: java-17-openjdk-devel
BuildRequires: jetty
BuildRequires: sipxcommons >= %version
BuildRequires: sipxconfig >= %version
Requires: sipxconfig >= %version
Requires: sipxcommons >= %version
Requires: jetty

Source: %name-%version.tar.gz
Prefix: %_prefix
BuildRoot: %{_tmppath}/%name-%version-root

%description
Server-side WebRTC integration for sipXecs.

%prep
%setup -q

%build
%configure --enable-rpmbuild @SIPX_RPM_CONFIGURE_OPTIONS@
make

%install
rm -rf $RPM_BUILD_ROOT
make DESTDIR=$RPM_BUILD_ROOT install

%clean
rm -rf $RPM_BUILD_ROOT

%files
%defattr(644,root,root,755)
%attr(755,root,root) %{_sysconfdir}/init.d/sipxwebrtc
%attr(644,root,root) /usr/lib/systemd/system/sipxwebrtc.service
%config(noreplace) %{_sysconfdir}/sipxpbx/sipxwebrtc.properties
%{_datadir}/sipxecs/cfinputs/plugin.d/sipxwebrtc.cf
%dir %attr(755,sipx,sipx) %{_datadir}/java/sipXecs/sipXwebrtc
%{_datadir}/java/sipXecs/sipXwebrtc/sipXwebrtc-gateway.jar
%{_datadir}/java/sipXecs/sipXconfig/plugins/sipxwebrtc-config.jar

%post
if systemctl is-enabled --quiet sipxwebrtc.service; then
	systemctl reenable sipxwebrtc.service >/dev/null 2>&1 || :
fi