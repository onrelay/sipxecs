<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
         http://www.springframework.org/schema/beans
         http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="webrtcHook" class="org.sipfoundry.sipxconfig.web.plugin.WebrtcHook">
    <property name="hookId" value="WebrtcMenu"/>
    <property name="featureId" value="webrtc"/>
  </bean>

  <bean id="webrtcSettings" class="org.sipfoundry.sipxconfig.webrtc.WebrtcSettings" parent="settingsBean"/>

  <bean id="webrtc" class="org.springframework.aop.framework.ProxyFactoryBean" parent="proxySupport">
    <property name="target" ref="webrtcImpl"/>
    <property name="proxyInterfaces" value="org.sipfoundry.sipxconfig.webrtc.Webrtc"/>
  </bean>

  <bean id="webrtcImpl" class="org.sipfoundry.sipxconfig.webrtc.WebrtcImpl">
    <property name="settingsDao">
      <bean parent="beanWithSettingsDao">
        <property name="target">
          <bean parent="beanWithSettingsDaoImpl">
            <constructor-arg value="org.sipfoundry.sipxconfig.webrtc.WebrtcSettings"/>
          </bean>
        </property>
      </bean>
    </property>
  </bean>

  <bean id="webrtcPhoneStandard" abstract="true" parent="abstractPhoneModel">
    <property name="beanId" value="webrtc"/>
    <property name="label" value="SIPX WebRTC"/>
    <property name="maxLineCount" value="1"/>
    <property name="profileTemplate" value="webrtc/provisioning.json.vm"/>
    <property name="vendor" value="OnRelay"/>
    <property name="serialNumberPattern" value="[a-zA-Z0-9]+"/>
  </bean>

  <bean id="webrtcPhoneModel" class="org.sipfoundry.sipxconfig.webrtc.device.WebrtcPhoneModel"
        parent="webrtcPhoneStandard">
    <property name="label" value="SIPX WebRTC"/>
  </bean>

  <bean id="webrtcPhone" class="org.sipfoundry.sipxconfig.webrtc.device.WebrtcPhone"
        scope="prototype" parent="abstractPhone"/>

</beans>