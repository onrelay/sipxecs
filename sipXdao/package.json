{
  "name": "@sipxdao",
  "private": true,
  "version": "1.0.0",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:make": "pnpm exec tsc -p tsconfig.json --outDir ../build/sipXdao",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dao/common": "link:../dao/packages/common",
    "@dao/configuration": "link:../dao/packages/configuration",
    "@dao/database": "link:../dao/packages/database",
    "@dao/security": "link:../dao/packages/security"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
