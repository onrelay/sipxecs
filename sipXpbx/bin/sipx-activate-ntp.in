#!/bin/sh

remove_self () {
    local myname=`basename $0`
    rm -f $0
}

NTPD_NAME="ntpd"
if test -f /etc/SuSE-release; then
  NTPD_NAME="ntp"
fi

# Enable the service at boot 
systemctl enable $NTPD_NAME.service >/dev/null 2>&1 || :

# Start the service if not already running
if ! systemctl is-active --quiet $NTPD_NAME.service; then
    systemctl start $NTPD_NAME.service && remove_self
else
    remove_self
fi