[Unit]
Description=sipxregistrar
Documentation=https://github.com/onrelay/sipxecs
After=network.target syslog.target

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxregistrar start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxregistrar stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxregistrar/sipxregistrar.pid

[Install]
WantedBy=multi-user.target
