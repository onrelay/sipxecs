[Unit]
Description=sipxregistrar
Documentation=https://github.com/onrelay/sipxecs
After=network-online.target syslog.target named.service postgresql.service mongod.service
Requires=postgresql.service mongod.service

[Service]
Type=forking
ExecStart=@SIPX_SERVICEDIR@/sipxregistrar start
RemainAfterExit=true
ExecStop=@SIPX_SERVICEDIR@/sipxregistrar stop
StandardOutput=journal
PIDFile=/run/sipxpbx/sipxregistrar/sipxregistrar.pid

[Install]
WantedBy=multi-user.target
